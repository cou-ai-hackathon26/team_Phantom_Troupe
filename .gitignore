# =====================================================================
# AdhikarAI — root .gitignore
# Python/FastAPI backend (backend/), Next.js frontend (frontend/),
# local ML models, data pipeline outputs. frontend/.gitignore adds
# Next.js-specific rules on top of this file.
# =====================================================================

# ---------------------------------------------------------------------
# Secrets (never commit; only .env.example with variable names)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.crt
*.p12
credentials*.json
service-account*.json
secrets/

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.ipynb_checkpoints/

# coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------
# ML models and HuggingFace / torch caches (downloaded at runtime)
# ---------------------------------------------------------------------
.cache/
models_cache/
hf_cache/
.huggingface/
*.safetensors
*.bin
*.onnx
*.pt
*.pth
*.ckpt
# OCR engine model downloads (EasyOCR, Surya, PaddleOCR)
.EasyOCR/
.paddleocr/
.surya/

# ---------------------------------------------------------------------
# Data
# Tracked deliberately: data/originals/ and data/processed/*.jsonl
# Ignored: anything rebuildable from them
# ---------------------------------------------------------------------
data/index/
data/parsed/
data/ocr/
data/tmp/
data/evaluation/checkpoint*.jsonl
data/evaluation/results/
*.pkl
*.faiss
tmp_audio/
*.wav
*.webm
*.mp3

# Raw scraped labour-act PDFs (kept local; NOTE: already committed, so
# run `git rm -r --cached "data/Workers — Bangladesh Labour Act 2006"`
# for this rule to take effect)
/data/Workers — Bangladesh Labour Act 2006/

# Local DB / vector store volumes (infra/docker-compose.yml offline profile)
infra/data/
infra/volumes/
qdrant_storage/
pgdata/
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/next-env.d.ts
frontend/.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak

# ---------------------------------------------------------------------
# AI assistant local state (CLAUDE.md stays tracked)
# ---------------------------------------------------------------------
.agents/
.claude/settings.local.json

# admin upload temp files (originals are preserved in data/originals/)
data/uploads/
