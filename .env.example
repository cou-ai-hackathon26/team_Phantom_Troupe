# Copy to .env and fill in. Never commit .env. Never paste keys into chat.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Supabase -> Connect -> Session pooler string, with +asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Qdrant Cloud free cluster
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=adhikarai_chunks

# Groq (free tier, no card)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b   # best in our 21 Nov comparison (scripts/test_llm_models.py)
LLM_TIMEOUT_S=20
# longest single wait on a Groq 429 (it sends retry-after); max 3 retries
LLM_RATE_LIMIT_MAX_WAIT_S=20
STT_MODEL=whisper-large-v3

# Local embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_DEVICE=auto          # auto | cuda | cpu

# Retrieval
RETRIEVAL_MIN_SCORE=0.80       # tune with scripts/run_eval.py --fresh

# Local OCR only
OCR_PROVIDER=tesseract
OCR_SECOND_ENGINE=easyocr      # only easyocr is wired
OCR_DEVICE=auto
OCR_MIN_CONFIDENCE=70

# Admin panel (/admin): admins log in with email + password (create with scripts/create_admin.py)
APP_SECRET_KEY=                # long random string; signs admin login sessions
ADMIN_SESSION_HOURS=12
ADMIN_TOKEN=                   # optional static key for scripts/curl (Authorization: Bearer …)
MAX_UPLOAD_MB=25

# Users' personal documents: kept in memory only, deleted after this many minutes
USER_DOC_TTL_MINUTES=60

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Tavily web search (free tier, no card): https://tavily.com
TAVILY_API_KEY=
# web fallback: search an allow-list of official sites when local evidence is weak (off for offline demos)
WEB_FALLBACK=false
WEB_TRIGGER_SCORE=0.85
WEB_MAX_RESULTS=3
# optional comma-separated override; leave commented out for the default list (an empty value blocks every site)
# WEB_ALLOWED_DOMAINS=

# Text-to-speech (ElevenLabs): 🔊 button. Bangla needs eleven_v3/v4. Optional overrides:
# TTS_ENABLED, TTS_MODEL_ID, TTS_VOICE_ID, TTS_OUTPUT_FORMAT, TTS_MAX_CHARS, TTS_TIMEOUT_S
ELEVENLABS_API_KEY=

# Follow-up conversations (in process memory only; optional overrides)
# CONVERSATION_TTL_MINUTES=120
# CONVERSATION_MAX_COUNT=1000
# CONVERSATION_HISTORY_EXCHANGES=3
# CONVERSATION_MAX_REUSED_SOURCES=3
